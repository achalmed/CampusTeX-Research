%% ============================================================================
%% academic-fonts.sty — Tipografía única del framework (LuaLaTeX + fontspec)
%% ----------------------------------------------------------------------------
%% Serif/Sans/Math: Libertinus (OTF en texmf, vía el paquete libertinus, que
%% carga unicode-math) · Mono: Inconsolata (cargada por ARCHIVO desde texmf,
%% porque fontconfig no la lista). Microtipografía moderna: protrusion +
%% EXPANSION (algoritmo hz). Bajo LuaLaTeX la expansion SÍ se aplica (XeLaTeX
%% la ignoraba); es la mejora tipográfica que el diseño ya prometía. Motor
%% único: LuaLaTeX.
%% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academic-fonts}[2026/07/23 v2 Tipografia Academic (LuaLaTeX)]

\RequirePackage{fontspec}

% Texto y matemática: Libertinus (Serif + Sans + Math; carga unicode-math).
% El wrapper `libertinus` despacha a libertinus-otf bajo LuaLaTeX (via \iftutex),
% que fija \setmathfont{LibertinusMath}. Sin opción `mono` (dispararía
% AnonymousPro); el mono lo sobrescribimos abajo con Inconsolata.
\RequirePackage{libertinus}

% Monoespaciada: Inconsolata, por archivo OTF de texmf (kpathsea la encuentra).
\setmonofont{InconsolataN}[
  Extension   = .otf,
  UprightFont = *-Regular,
  BoldFont    = *-Bold,
  Scale       = MatchLowercase]

% Microtipografía: protrusion (márgenes ópticos) + expansion (algoritmo hz de
% Hàn Thế Thành). La EXPANSION solo es efectiva bajo LuaLaTeX/pdfTeX; XeLaTeX la
% ignora. Con LuaLaTeX + fuentes OTF (luaotfload) funciona y mejora el «gris»
% tipográfico y la justificación. No toca la matemática (unicode-math) ni el
% monoespaciado; en Beamer su efecto es marginal (texto centrado/ragged).
\RequirePackage[protrusion=true,expansion=true,final]{microtype}

% Idioma (LuaLaTeX-native) y comillas tipográficas -----------------------
\RequirePackage{polyglossia}
\setdefaultlanguage{spanish}
\RequirePackage[autostyle=true]{csquotes}   % \enquote sigue el idioma
\endinput
