%% ============================================================================
%% academic-code.sty — Código fuente (R · Python · Stata) y salidas de consola
%% ----------------------------------------------------------------------------
%% Resaltado sobrio y monocromo: palabras clave en acento, comentarios en gris,
%% filete fino a la izquierda. Un solo estilo para todo el material.
%% Uso: \begin{codigo}[language=R] ... \end{codigo}   ·   \begin{salida} ...
%% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academic-code}[2026/07/23 v1 Codigo Academic]
\RequirePackage{listings}
\RequirePackage{academic-colors}

% Stata no es lenguaje nativo de listings: definición mínima.
\lstdefinelanguage{Stata}{
  morekeywords={reg,regress,summarize,generate,gen,replace,egen,merge,append,
    use,save,import,export,tabulate,tab,collapse,reshape,keep,drop,sort,by,
    bysort,local,global,foreach,forvalues,while,if,else,program,scalar,matrix,
    predict,margins,estimates,xtset,tsset,logit,probit,ivregress,areg,xtreg},
  sensitive=true, morecomment=[l]{*}, morecomment=[l]{//},
  morecomment=[n]{/*}{*/}, morestring=[b]", morestring=[b]'}

\lstdefinestyle{academic}{
  basicstyle=\ttfamily\small\color{textoprincipal},
  keywordstyle=\color{acento}\bfseries,
  commentstyle=\color{secundario}\itshape,
  stringstyle=\color{secundario},
  numberstyle=\ttfamily\scriptsize\color{secundario},
  numbers=left, numbersep=10pt, xleftmargin=16pt,
  frame=single, framerule=0pt, framesep=6pt, rulecolor=\color{cajafondo}, backgroundcolor=\color{cajafondo},
  breaklines=true, breakatwhitespace=true, showstringspaces=false,
  columns=fullflexible, keepspaces=true, tabsize=2,
  aboveskip=8pt, belowskip=8pt}

\lstset{style=academic}
\lstnewenvironment{codigo}[1][]{\lstset{style=academic,#1}}{}

% Salida de consola: sin numeración, gris, sin resaltado.
\lstdefinestyle{academic@salida}{
  basicstyle=\ttfamily\footnotesize\color{secundario},
  numbers=none, frame=single, framerule=0pt, framesep=6pt, rulecolor=\color{cajafondo}, backgroundcolor=\color{cajafondo},
  xleftmargin=0pt, breaklines=true, showstringspaces=false,
  columns=fullflexible, aboveskip=6pt, belowskip=8pt}
\lstnewenvironment{salida}[1][]{\lstset{style=academic@salida,#1}}{}
\endinput
