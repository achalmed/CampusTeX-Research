%% ============================================================================
%% academic.sty — Identidad visual «Academic» (meta-paquete, ÚNICO punto de entrada)
%% ----------------------------------------------------------------------------
%% La cargan por igual las clases de documento (academic-base y derivadas) y el
%% tema Beamer (beamerthemeAcademic). Un solo origen de verdad visual para todo
%% el material docente: diapositivas, exámenes, reports y pósters.
%%
%% Motor: LuaLaTeX exclusivamente.  Orden importante: amsmath antes de unicode-math
%% (que carga academic-fonts vía libertinus).
%% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academic}[2026/07/23 v1 Identidad Academic (LuaLaTeX)]

\RequirePackage{amsmath}          % antes de unicode-math
\RequirePackage{academic-colors}  % paleta (config/palette.tex)
\RequirePackage{academic-fonts}   % tipografía fontspec (Libertinus→unicode-math + Inconsolata)
\RequirePackage{academic-math}    % mathtools + operadores comunes
\RequirePackage{academic-icons}   % iconografía (fontawesome5)
\RequirePackage{academic-tables}  % tablas booktabs + notas
% academic-figures carga `caption`, que choca con Beamer (maneja sus propias
% leyendas). En diapositivas se omite; en documentos sí se carga.
\@ifclassloaded{beamer}{}{\RequirePackage{academic-figures}}
\RequirePackage{academic-boxes}   % cajas tcolorbox (nota, definición, teorema…)
\RequirePackage{academic-code}    % código R/Python/Stata + salidas
\endinput
