%% ============================================================================
%% academic-math.sty — Matemática (unicode-math ya lo carga libertinus)
%% ----------------------------------------------------------------------------
%% mathtools (y con él amsmath) se carga en academic.sty ANTES de unicode-math: cargado
%% después rompe \underbrace/\overbrace (R9, 2026-09-15). Aquí solo operadores y macros comunes.
%% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academic-math}[2026/07/23 v1 Matematica Academic]
\RequirePackage{mathtools}   % no-op: ya cargado por academic.sty; se deja por si el .sty se usa suelto

% Conjuntos y operadores frecuentes
\providecommand{\R}{\mathbb{R}}
\providecommand{\N}{\mathbb{N}}
\providecommand{\Z}{\mathbb{Z}}
\providecommand{\E}{\mathbb{E}}
\providecommand{\Prob}{\mathbb{P}}
\DeclareMathOperator{\Var}{Var}
\DeclareMathOperator{\Cov}{Cov}
\DeclareMathOperator{\Corr}{Corr}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator{\plim}{plim}
\endinput
