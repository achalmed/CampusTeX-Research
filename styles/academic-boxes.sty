%% ============================================================================
%% academic-boxes.sty — Cajas informativas (tcolorbox), editorial minimalista
%% ----------------------------------------------------------------------------
%% Sin marcos completos, sin sombras, sin degradados: solo un filete de acento a
%% la izquierda, fondo suave y rótulo en versalitas + icono. Idéntico en B/N.
%% Un solo estilo base; cada caja semántica lo especializa con título propio.
%% Uso: \begin{nota} ... \end{nota}   ·   \begin{nota}[Título propio] ...
%% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academic-boxes}[2026/07/23 v1 Cajas Academic]
\RequirePackage[most]{tcolorbox}
\RequirePackage{academic-colors}
\RequirePackage{academic-icons}

% Estilo base «academicbox»: filete de acento a la izquierda, fondo suave.
\tcbset{academicbox/.style={
  enhanced, breakable, frame hidden, sharp corners,
  colback=cajafondo, colbacktitle=cajafondo, titlerule=0pt,
  borderline west={1.6pt}{0pt}{acento},
  boxrule=0pt, left=10pt, right=8pt, top=6pt, bottom=6pt,
  before skip=8pt, after skip=8pt,
  coltitle=acento, fonttitle=\bfseries\small}}

% Cajas simples (título por defecto + override opcional) --------------------
\newtcolorbox{nota}[1][Nota]{academicbox, title={\iconnota\ \textsc{#1}}}
\newtcolorbox{ejemplo}[1][Ejemplo]{academicbox, title={\iconejemplo\ \textsc{#1}}}
\newtcolorbox{observacion}[1][Observación]{academicbox, title={\iconobservacion\ \textsc{#1}}}
\newtcolorbox{importante}[1][Importante]{academicbox, title={\iconimportante\ \textsc{#1}}}
\newtcolorbox{instrucciones}[1][Instrucciones]{academicbox, title={\iconinstrucciones\ \textsc{#1}}}
\newtcolorbox{formulario}[1][Formulario]{academicbox, title={\iconformulario\ \textsc{#1}}}
\newtcolorbox{datos}[1][Datos]{academicbox, title={\icondatos\ \textsc{#1}}}
\newtcolorbox{criterios}[1][Criterios]{academicbox, title={\iconcriterios\ \textsc{#1}}}

% Cajas numeradas con nombre opcional (definición / teorema) ----------------
\NewTColorBox[auto counter,number within=section]{definicion}{o}{academicbox,
  title={\icondefinicion\ \textsc{Definición}~\thetcbcounter\IfValueT{#1}{\ \normalfont\itshape(#1)}}}
\NewTColorBox[auto counter,number within=section]{teorema}{o}{academicbox,
  title={\iconteorema\ \textsc{Teorema}~\thetcbcounter\IfValueT{#1}{\ \normalfont\itshape(#1)}}}
\endinput
