%% ============================================================================
%% beamerthemeacademic.sty — Tema Beamer «Academic» (orquestador)
%% ----------------------------------------------------------------------------
%% Carga la MISMA identidad visual que los documentos (styles/academic.sty:
%% colores, fuentes fontspec, cajas, código, iconos, math) y luego los 4
%% sub-temas de Beamer. Así una diapositiva y un examen comparten color y
%% tipografía al carácter, con config/palette.tex como único punto de cambio.
%%
%% Inspiración: Harvard · Oxford · ETH · Tufte · Keynote. Sin degradados,
%% sombras, efectos ni cajas decorativas.
%% ============================================================================
\ProvidesPackage{beamerthemeacademic}[2026/07/23 v1 Tema Academic (LuaLaTeX)]
\mode<presentation>

% Identidad visual única (compartida con academic-base y academic-exam)
\RequirePackage{academic}

% Sub-temas
\usecolortheme{academic}
\usefonttheme{academic}
\useinnertheme{academic}
\useoutertheme{academic}

% Márgenes editoriales generosos (aire)
\setbeamersize{text margin left=1.1cm, text margin right=1.1cm}

% Sin relleno vertical automático: contenido anclado arriba (retícula editorial)
\setbeamertemplate{frametitle continuation}{}

% Autoría del PDF: siempre el autor del framework (metadatos), por encima del \author.
\AtBeginDocument{\hypersetup{pdfauthor={\academicauthor}}}

\mode<all>
